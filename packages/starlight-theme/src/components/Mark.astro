---
/**
 * The yielded mark: a y whose stem grows out of `yield*`'s asterisk, in `currentColor`.
 * `assets/mark.svg` is copied from the brand repository's generated assets.
 */
import source from "../../assets/mark.svg?raw";

interface Props {
  /** Height in pixels. */
  readonly size?: number;
}

const { size = 22 } = Astro.props;
const [, width = "0", height = "0"] = /viewBox="0 0 ([\d.]+) ([\d.]+)"/.exec(source) ?? [];
const d = /\sd="([^"]+)"/.exec(source)?.[1];
---

<svg
  class="yl-mark"
  viewBox={`0 0 ${width} ${height}`}
  width={Math.round(((size * Number(width)) / Number(height)) * 100) / 100}
  height={size}
  aria-hidden="true"
>
  <path fill="currentColor" d={d}></path>
</svg>

<style>
  .yl-mark {
    flex: none;
  }
</style>
