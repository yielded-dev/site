---
/**
 * An application table beside the library tables that reference it. Accent marks what the
 * library manages; neutral marks what the application owns.
 *
 * ```mdx
 * <TableMap
 *   table="customers"
 *   columns={[{ name: "customer_key", role: "subject ID" }, { name: "display_name" }]}
 *   link="subject_id"
 *   managed={["customer_auth_sessions"]}
 * />
 * ```
 *
 * The first column is the key that `link` names in the managed tables.
 */
import { libraryOwner } from "../diagrams.ts";

interface Props {
  readonly table: string;
  readonly columns: ReadonlyArray<{ readonly name: string; readonly role?: string }>;
  readonly link: string;
  readonly managed: ReadonlyArray<string>;
  readonly more?: string;
}

const { table, columns, link, managed, more } = Astro.props;
---

<figure class="table-map not-content">
  <div class="yours">
    <p class="owner">Your table</p>
    <div class="table">
      <code class="name">{table}</code>
      <ul>
        {
          columns.map(({ name, role }, index) => (
            <li data-mapped={role !== undefined ? "" : undefined} data-link={index === 0 ? "" : undefined}>
              <code class="column">{name}</code>
              {role !== undefined && <span>{role}</span>}
            </li>
          ))
        }
        <li class="rest">Your other columns</li>
      </ul>
    </div>
  </div>
  <div class="managed">
    <p class="owner">Managed by {libraryOwner}</p>
    <ul>
      {
        managed.map((name) => (
          <li>
            <code class="managed-table">{name}</code>
          </li>
        ))
      }
      {more !== undefined && <li class="more">{more}</li>}
    </ul>
    <span class="link-label" aria-hidden="true">{link}</span>
  </div>
</figure>

<style>
  .table-map {
    --wire: var(--sl-color-accent);
    --gap: 6rem;
    --row: 2.25rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    margin: 1.5rem 0 0;
  }

  .owner {
    height: 1.5rem;
    margin: 0 0 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .managed .owner {
    color: var(--sl-color-accent);
  }

  .table-map :is(.name, .column, .managed-table) {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The application table. */
  .table {
    border: 1px solid var(--yl-border-strong);
    border-radius: 0.5rem;
    background: var(--yl-bg-raised);
  }

  .table-map .name {
    display: flex;
    align-items: center;
    height: var(--row);
    padding: 0 0.9rem;
    border-bottom: 1px solid var(--yl-border-strong);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .table li {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    height: var(--row);
    padding: 0 0.9rem;
    color: var(--sl-color-white);
  }

  .table li + li {
    border-top: 1px solid var(--yl-border);
  }

  .table li span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .table li[data-mapped] span {
    color: var(--sl-color-accent);
  }

  .table .rest {
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-sm);
    font-style: italic;
  }

  /* The key reaches across to the bus that feeds the managed tables. */
  .table li[data-link]::after {
    position: absolute;
    top: 50%;
    left: calc(100% + 1px);
    width: var(--gap);
    border-top: 1.5px solid var(--wire);
    content: "";
  }

  .managed {
    position: relative;
  }

  .link-label {
    position: absolute;
    top: calc(1.5rem + 0.75rem + var(--row) * 1.5 - 1.35rem);
    right: calc(100% + 0.6rem);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }

  .managed ul {
    padding-left: 1.25rem;
  }

  .managed li {
    position: relative;
    display: flex;
    align-items: center;
    height: var(--row);
    margin-bottom: 0.4rem;
  }

  .table-map .managed-table {
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 0 0.8rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--wire) 45%, var(--yl-border));
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--wire) 7%, var(--yl-bg-raised));
    color: var(--sl-color-white);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .managed li::before {
    position: absolute;
    top: -0.4rem;
    bottom: 0;
    left: -1.25rem;
    border-left: 1.5px solid var(--wire);
    content: "";
  }

  .managed li::after {
    position: absolute;
    top: 50%;
    left: -1.25rem;
    width: 1.25rem;
    border-top: 1.5px solid var(--wire);
    content: "";
  }

  .managed li:first-child::before {
    top: 50%;
  }

  .managed li:last-child::before {
    bottom: 50%;
  }

  .managed .more {
    padding-left: 0.8rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  @media (max-width: 48rem) {
    .table-map {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .table li[data-link]::after,
    .link-label {
      display: none;
    }
  }
</style>
