---
/** Page title with the sidebar group it belongs to as an eyebrow. */
import { currentGroup } from "../sidebar.ts";

const { entry, sidebar } = Astro.locals.starlightRoute;
const group = currentGroup(sidebar);
---

{group !== undefined && <p class="yl-eyebrow">{group}</p>}
<h1 id="_top">{entry.data.title}</h1>

<style>
  .yl-eyebrow {
    margin: 1rem 0 0.6rem;
    color: var(--sl-color-accent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .yl-eyebrow + h1 {
    margin-top: 0;
  }

  h1 {
    margin-top: 1rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h1);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
</style>
