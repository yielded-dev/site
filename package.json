{
  "name": "yielded-site",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    ".dependencies/auth/packages/auth",
    ".dependencies/auth/packages/auth-persistence",
    ".dependencies/auth/packages/crypto",
    ".dependencies/auth/packages/jose",
    ".dependencies/auth/packages/oauth"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "effect-tsgo patch --typescript",
    "changeset": "bun x changeset",
    "changeset:version": "bun x changeset version",
    "ci:version": "bun x changeset version && bun install",
    "dev": "vp run @yielded/landing#dev",
    "check": "vp check && vp run -r --concurrency-limit 1 typecheck && tsc --noEmit -p tsconfig.json",
    "build": "vp run -F './apps/*' -F './packages/*' build",
    "ready": "vp run check && vp run build",
    "release": "vp run ready && bun x changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "scheduler": "0.27.0",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@astrojs/starlight": "0.42.4",
    "@effect/platform-node": "4.0.0",
    "@effect/tsgo": "0.48.1",
    "@types/node": "26.1.2",
    "alchemy": "2.0.0-beta.80",
    "astro": "7.3.5",
    "effect": "4.0.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "@effect/platform-bun": "4.0.0",
    "@effect/atom-react": "4.0.0",
    "@effect/sql-sqlite-bun": "4.0.0",
    "@effect/sql-sqlite-do": "4.0.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.4",
    "@cloudflare/workers-types": "5.20260926.1",
    "@effect/vitest": "4.0.0",
    "@effect/sql-libsql": "4.0.0",
    "@effect/sql-sqlite-node": "4.0.0",
    "jose": "6.2.12",
    "vitest": "4.1.11"
  }
}
