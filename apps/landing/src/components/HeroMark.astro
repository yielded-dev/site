---
/**
 * The yielded mark at display size, drawn in on load: the y's stem, its arm, then the star's points.
 * The strokes are the brand repository's source geometry (`src/mark.ts`) on its 100-unit grid.
 */
const letter = 12;
const star = 10;

const strokes = [
  { d: "M66 27 L44 79 Q38.5 92 26 92", width: letter, delay: 0, duration: 820 },
  { d: "M27.5 37 L46.962 72", width: letter, delay: 360, duration: 520 },
  ...["L52.052 25.796", "L62.835 13.363", "L77.992 19.775", "L76.577 36.172"].map((end, index) => ({
    d: `M66 27 ${end}`,
    width: star,
    delay: 760 + index * 70,
    duration: 340,
  })),
];
---

<svg class="hero-mark" viewBox="4.5 6.2 94 94" aria-hidden="true">
  {
    strokes.map(({ d, width, delay, duration }) => (
      <path
        d={d}
        pathLength="1"
        stroke-width={width}
        style={`--delay:${delay}ms;--duration:${duration}ms`}
      />
    ))
  }
</svg>

<style>
  .hero-mark {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--yl-text);
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    animation: draw var(--duration) cubic-bezier(0.65, 0, 0.35, 1) var(--delay) forwards;
  }

  /* Opacity hides the round cap that would otherwise show as a dot before each stroke starts. */
  @keyframes draw {
    from {
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    path {
      stroke-dashoffset: 0;
      opacity: 1;
      animation: none;
    }
  }
</style>
