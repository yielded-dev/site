{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "exactOptionalPropertyTypes": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/sql-sqlite-bun",
          "@effect/sql-sqlite-do",
          "effect/http",
          "effect/persistence/KeyValueStore",
          "effect/reactivity",
          "effect/sql"
        ],
        "diagnosticSeverity": {
          "unknownRuleName": "error",
          "preferTypedSchemaDecoder": "error"
        }
      }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "alchemy.run.ts"]
}
