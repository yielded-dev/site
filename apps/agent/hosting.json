{
  "repository": "https://github.com/yielded-dev/agent.git",
  "revision": "951f1d73a428f9255a14d1a1b6288a809afcb2ca",
  "planner": {
    "stackName": "effect-agent-travel-planner",
    "workerName": "effect-agent-travel-planner",
    "artifactsNamespace": "effect-agent-travel-planner-auth-v1",
    "appDomain": "effect-agent.com",
    "appZoneId": "9662e63e42d87b741fbcae6b65506924",
    "domain": "travel.effect-agent.com",
    "routes": [
      { "pattern": "agent.yielded.dev/travel*", "zoneName": "yielded.dev" },
      { "pattern": "*-trip.effect-agent.com/*", "zoneId": "9662e63e42d87b741fbcae6b65506924" }
    ],
    "workersDev": false
  },
  "auth": {
    "AUTH_ISSUER": "https://auth.yielded.dev",
    "AUTH_RESOURCE": "https://agent.yielded.dev",
    "AUTH_JWKS_URL": "https://auth.yielded.dev/oauth/yielded/jwks",
    "AUTH_HOSTED_MODEL_SCOPE": "agent:hosted-model"
  },
  "browser": {
    "name": "yielded-agent-browser-use",
    "main": "../examples/browser-speed/src/worker.ts",
    "compatibility_date": "2026-07-01",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
      { "pattern": "agent.yielded.dev/", "zone_name": "yielded.dev" },
      { "pattern": "agent.yielded.dev/browser-use*", "zone_name": "yielded.dev" }
    ],
    "assets": {
      "directory": "../examples/browser-speed/dist",
      "binding": "ASSETS",
      "run_worker_first": ["/api/*", "/browser-use/api/*"]
    },
    "browser": { "binding": "BROWSER", "remote": true },
    "worker_loaders": [{ "binding": "LOADER" }],
    "durable_objects": { "bindings": [{ "name": "LAB", "class_name": "BrowserLab" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrowserLab"] }],
    "ratelimits": [
      { "name": "RUN_LIMIT", "namespace_id": "4401", "simple": { "limit": 6, "period": 60 } }
    ],
    "observability": { "enabled": false }
  }
}
